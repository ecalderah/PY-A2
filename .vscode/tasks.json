{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-commit (git)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tools/auto-commit.ps1"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "auto",
        "echo": false
      }
    }
  ]
}
